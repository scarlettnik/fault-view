{
  "name": "faultview",
  "private": true,
  "description": "FaultView monorepo: landing, frontend and backend",
  "scripts": {
    "setup:landing": "npm --prefix apps/landing ci",
    "dev:landing": "npm --prefix apps/landing run dev",
    "lint:landing": "npm --prefix apps/landing run lint",
    "check:landing": "npm --prefix apps/landing run check",
    "build:landing": "npm --prefix apps/landing run build",
    "precommit": "npm --prefix apps/landing run precommit",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  }
}
