{
	servers {
		protocols h1 h2
	}
}

{$FAULTVIEW_PUBLIC_HOST} {
	encode zstd gzip
	redir /app /app/ 308
	redir /examples/* https://scarlettnik.github.io/fault-view{uri} 302
	redir /storybook/* https://scarlettnik.github.io/fault-view{uri} 302
	@backend path /app/* /api/v1 /api/v1/* /health
	handle @backend {
		reverse_proxy app:3001 {
			transport http {
				keepalive 30s
			}
		}
	}
	handle {
		root * /srv/landing
		file_server
	}
}
