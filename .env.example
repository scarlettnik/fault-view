# Local development. Export these variables before npm run dev:fullstack.
# Generate real credentials in your local environment or on the VPS.
DATABASE_URL=postgresql://faultview:replace_me@127.0.0.1:5432/faultview
FAULTVIEW_CLIENT_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
FAULTVIEW_HOST=127.0.0.1
FAULTVIEW_RUNNER_PORT=3001
FAULTVIEW_FRONTEND_PORT=5173
FAULTVIEW_LANDING_PORT=4173
FAULTVIEW_DEMO_PORT=4400
# dev:fullstack launches Storefront on loopback unless FAULTVIEW_DEMO_URL is set.
# FAULTVIEW_DEMO_URL=http://127.0.0.1:4400/
# Additional permitted origins for your local test sites.
# FAULTVIEW_TARGET_ORIGINS=http://127.0.0.1:5173

FAULTVIEW_S3_ENDPOINT=http://127.0.0.1:8333
FAULTVIEW_S3_BUCKET=faultview-shots
FAULTVIEW_S3_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set only for a separate SPA process. The integrated script sets this automatically.
# VITE_API_URL=http://127.0.0.1:3001/api/v1
# VITE_BASE_PATH=/
# SITE_BASE_PATH=/fault-view/

# API and browser tests need a disposable database and a separate bucket.
# TEST_DATABASE_URL=postgresql://faultview:replace_me@127.0.0.1:5432/faultview_test
# FAULTVIEW_S3_TEST_BUCKET=faultview-test

# Production Compose uses .env.production generated by npm run prepare:vps.
# FAULTVIEW_PUBLIC_HOST=faultview.example.org
# FAULTVIEW_POSTGRES_PASSWORD=
# FAULTVIEW_POSTGRES_ADMIN_PASSWORD=
